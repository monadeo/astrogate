{
  "name": "astrogate",
  "version": "0.0.3",
  "packageManager": "pnpm@11.8.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @monadeo.com/astrogate-protocol build && pnpm --filter @monadeo.com/astrogate-controller build && pnpm --filter @monadeo.com/astrogate-companion build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "check": "pnpm --filter @monadeo.com/astrogate-protocol build && pnpm typecheck && pnpm lint && pnpm test",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
